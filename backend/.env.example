PORT=3000
MONGODB_URI=
# Used by auth — set BOTH (do not use a single JWT_SECRET)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
NODE_ENV=production

# Dashboard origin(s) allowed for credentialed CORS (comma-separated extras OK)
FRONTEND_URL=https://your-dashboard.example.com
FRONTEND_BASE_URL=https://your-dashboard.example.com
CORS_ORIGINS=

# Google OAuth — must match dashboard VITE_GOOGLE_CLIENT_ID exactly
GOOGLE_CLIENT_ID=

# AI (EchoBot / dispute resolver)
GEMINI_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP (use an App Password from the SAME Google account as SMTP_USER)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=EchoStream
# Alias also accepted by the app:
# MAIL_FROM=
