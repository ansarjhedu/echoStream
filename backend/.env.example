PORT=3000
MONGODB_URI=
# Used by auth — set BOTH (do not use a single JWT_SECRET)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
NODE_ENV=production

# Dashboard origin(s) allowed for credentialed CORS (comma-separated extras OK)
FRONTEND_URL=https://www.echo-stream.org
FRONTEND_BASE_URL=https://www.echo-stream.org
CORS_ORIGINS=

# Google OAuth — must match dashboard VITE_GOOGLE_CLIENT_ID exactly
GOOGLE_CLIENT_ID=

# AI (EchoBot / smart replies)
GEMINI_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP (use an App Password from the SAME Google account as SMTP_USER)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=EchoStream
# Alias also accepted by the app:
# MAIL_FROM=

# Lemon Squeezy (Merchant of Record) — works for Pakistan founders
# Checkout supports Visa, Mastercard, Google Pay, Apple Pay
# Create Growth/Pro subscription products → copy variant IDs
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_GROWTH=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Webhook URL: https://echo-stream-pi.vercel.app/api/billing/webhook
# Events: subscription_created, subscription_updated, subscription_cancelled, subscription_expired, subscription_payment_success
BACKEND_PUBLIC_URL=https://echo-stream-pi.vercel.app
# Protects POST/GET /api/cron/campaigns (Vercel Hobby: once daily at 00:00 UTC; upgrade later for hourly)
CRON_SECRET=
