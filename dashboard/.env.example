# Backend API (dashboard axios base)
VITE_BACKEND_URL=https://your-api.example.com/api

# Public widget script URL shown in Design Lab snippets
VITE_WIDGET_SCRIPT_URL=https://your-dashboard.example.com/widget/echo-widget.js

# Google Identity Services (Continue with Google)
VITE_GOOGLE_CLIENT_ID=

# Optional: live Presence widget on the marketing landing page
# Never commit a real key — set only in the host env (Vercel, etc.)
VITE_DEMO_WIDGET_API_KEY=
VITE_DEMO_WIDGET_HANDLE=portfolio
VITE_DEMO_WIDGET_TITLE=EchoStream
